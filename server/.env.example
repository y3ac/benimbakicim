# ---- Server ----
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Kritik akislari otomatik onaylamadan calistir (numarayi acmadan once true birak)
DRY_RUN=true
# Yonetim paneli erisim anahtari (/admin?token=...). Bos ise yerelde korumasiz.
ADMIN_TOKEN=

# ---- WhatsApp Cloud API (Meta) ----
# Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Webhook dogrulama icin kendi belirlediginiz gizli kelime
WHATSAPP_VERIFY_TOKEN=benimbakicim-verify
WHATSAPP_API_VERSION=v23.0
# Isletme hattiniz (basvuru/iletim bu numaradan gider)
BUSINESS_PHONE_DISPLAY=0535 596 35 45

# ---- Katalog (Meta Commerce Manager) ----
WHATSAPP_CATALOG_ID=
CATALOG_RETAILER_ID_BASE=iln-base-300
CATALOG_RETAILER_ID_ACIL=iln-base-acil
CATALOG_RETAILER_ID_UNLOCK2=iln-unlock-300
CATALOG_RETAILER_ID_UNLOCK6=iln-unlock-900

# ---- Odeme (Turkiye: iyzico / PayTR / mock) ----
# PAYMENT_PROVIDER: mock | iyzico | paytr
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=degistir-bu-degeri

# iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# PayTR
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# ---- Yapay Zeka (opsiyonel; yoksa kural tabanli fallback calisir) ----
# OPENAI_API_KEY bos ise sistem deterministik fallback ile calisir
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Yayin kanallari (Instagram / Facebook) ----
IG_USER_ID=
FB_PAGE_ID=
META_CONTENT_ACCESS_TOKEN=
# Yayin yapilacak WhatsApp grup tanimlari (virgulle ayrilmis etiketler)
PUBLISH_WA_GROUPS=istanbul-bakici,istanbul-yardimci
# Faz 2 (varsayilan kapali): WhatsApp Kanali ve Sahibinden
WHATSAPP_CHANNEL_ID=
SAHIBINDEN_ENABLED=false

# ---- Fiyatlandirma (TL) ----
PRICE_BASE=1000
PRICE_ACIL=1500
PRICE_UNLOCK2=1000
PRICE_UNLOCK6=1000
# Paket basina iletilen basvuran sayisi
REVEAL_BASE_COUNT=3
REVEAL_UNLOCK2_COUNT=3
UNLOCK6_THRESHOLD=3

# ---- Eslestirme ----
# Ilan toplama penceresi (saat). Sure dolunca skorlama yapilir.
MATCH_WINDOW_HOURS=24
