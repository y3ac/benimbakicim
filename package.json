{
  "name": "benimbakicim-site",
  "version": "1.0.0",
  "private": true,
  "description": "Benim Bakicim - web sitesi + Cloudflare Pages",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "build": "node scripts/build-cloudflare.mjs",
    "build:cf": "node scripts/build-cloudflare.mjs",
    "verify:cf": "node scripts/verify-cloudflare.mjs",
    "preview:cf": "npm run build:cf && wrangler dev --port 8788",
    "deploy:cf": "npm run build:cf && wrangler deploy",
    "deploy": "netlify deploy --prod",
    "bundle:functions": "esbuild netlify/lib/serverHandler.mjs --bundle --platform=node --format=cjs --outfile=netlify/lib/api_bundle.cjs --external:iyzipay --external:sql.js && esbuild netlify/lib/matchingHandler.mjs --bundle --platform=node --format=cjs --outfile=netlify/lib/matching_bundle.cjs --external:iyzipay --external:sql.js"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.9",
    "express": "^4.21.2",
    "iyzipay": "^2.0.64",
    "serverless-http": "^3.2.0",
    "sql.js": "^1.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}
